{
  "$comment": "Informal schema for Human Repository Proof of Life files, version 0.1.0. Not a formal JSON Schema draft. A .pol is evidence and attestation, not cryptographic proof of humanity.",
  "format": "pol",
  "version": "0.1.0",
  "required": ["format", "version", "title"],
  "fields": {
    "format": { "type": "string", "const": "pol" },
    "version": { "type": "string", "example": "0.1.0" },
    "title": { "type": "string" },
    "creator": {
      "type": "object",
      "fields": {
        "name": { "type": ["string", "null"] },
        "handle": { "type": ["string", "null"] },
        "public_key": { "type": ["string", "null"], "reserved": "for later signing" }
      }
    },
    "created": {
      "type": "object",
      "fields": {
        "session_start": { "type": ["string", "null"], "format": "iso-8601" },
        "session_end": { "type": ["string", "null"], "format": "iso-8601" },
        "recorded_at": { "type": ["string", "null"], "format": "iso-8601" }
      }
    },
    "duration_seconds": { "type": ["number", "null"] },
    "location": {
      "type": ["object", "null"],
      "opt_in": true,
      "fields": {
        "label": { "type": ["string", "null"] },
        "lat": { "type": ["number", "null"] },
        "lon": { "type": ["number", "null"] },
        "accuracy_m": { "type": ["number", "null"] },
        "source": { "type": ["string", "null"], "enum": ["manual", "browser_geolocation"] }
      }
    },
    "work": {
      "type": "object",
      "fields": {
        "type": { "enum": ["audio", "image", "text", "video", "other"] },
        "filename": { "type": ["string", "null"] },
        "sha256": { "type": ["string", "null"] },
        "bytes": { "type": ["number", "null"] },
        "note": { "type": ["string", "null"] },
        "embedded": {
          "type": ["object", "null"],
          "fields": {
            "encoding": { "const": "base64" },
            "media_type": { "type": "string" },
            "data": { "type": "string" }
          }
        }
      }
    },
    "attestation": {
      "type": "object",
      "fields": {
        "statement": { "type": "string" },
        "signed": { "type": "boolean", "default": false },
        "signature": { "type": ["string", "null"] },
        "algorithm": { "type": ["string", "null"] }
      }
    },
    "effort": {
      "type": "object",
      "fields": {
        "hours": { "type": ["number", "null"] },
        "drafts": { "type": ["number", "null"] },
        "tools": { "type": "array", "items": "string" },
        "collaborators": { "type": "array", "items": "string" },
        "interruptions": { "type": ["string", "null"] },
        "what_was_hard": { "type": ["string", "null"] },
        "narrative": { "type": ["string", "null"] }
      }
    },
    "biometrics": {
      "type": ["object", "null"],
      "opt_in": true,
      "self_attested_unless_device_signed": true,
      "fields": {
        "included": { "type": "boolean" },
        "self_attested": { "type": "boolean" },
        "device_signed": { "type": "boolean" },
        "source": { "enum": ["manual", "csv_upload", null] },
        "device": { "type": ["string", "null"] },
        "heart_rate": {
          "type": ["object", "null"],
          "fields": { "min": "number", "avg": "number", "max": "number", "samples": ["number", "null"] }
        },
        "steps": { "type": ["number", "null"] },
        "active_minutes": { "type": ["number", "null"] },
        "sweat_or_skin_conductance": {
          "type": ["object", "null"],
          "fields": { "value": ["number", "null"], "unit": ["string", "null"], "note": ["string", "null"] }
        },
        "sample_count": { "type": "number" },
        "note": { "type": ["string", "null"] }
      }
    },
    "related": {
      "type": "object",
      "fields": {
        "c2pa_sidecar": { "type": ["string", "null"] },
        "work_url": { "type": ["string", "null"] }
      }
    },
    "privacy": {
      "type": "object",
      "fields": {
        "location_included": "boolean",
        "coordinates_included": "boolean",
        "biometrics_included": "boolean",
        "work_embedded": "boolean",
        "work_hashed": "boolean"
      }
    },
    "integrity": {
      "type": "object",
      "fields": {
        "alg": { "const": "sha256" },
        "canonical_sha256": { "type": "string", "computed": "sha256 of canonical JSON with this field set to empty string" },
        "note": { "type": "string" }
      }
    }
  }
}
